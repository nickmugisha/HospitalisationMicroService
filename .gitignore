# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# Logs
*.log

*.sql
*.dump

# OS
.DS_Store
Thumbs.db

*.py[cod]

# Tests/cache
.pytest_cache/
.coverage
htmlcov/

# Temporary
*.tmp
*.bak
.run/


$ignoreLines = @(
    ".run/",
    "LOT_*_ENV_APPEND.txt"
)

foreach ($line in $ignoreLines) {
    if (-not (Select-String -Path ".gitignore" -SimpleMatch $line -Quiet -ErrorAction SilentlyContinue)) {
        Add-Content ".gitignore" $line
    }
}
.run/
LOT_*_ENV_APPEND.txt
